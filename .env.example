# Deepgram and OpenAI text LLM keys are always required. Cartesia is required
# only when REHEARSE_TTS_PROVIDER=cartesia. Never put keys in browser code.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Local server and session files.
REHEARSE_HOST=127.0.0.1
REHEARSE_PORT=7860
REHEARSE_SESSION_DIR=sessions

# Deepgram STT and OpenAI text LLM.
REHEARSE_STT_MODEL=nova-3-general
REHEARSE_LLM_MODEL=gpt-4.1-mini

# Cartesia streaming TTS is the default. OpenAI TTS remains selectable by
# setting REHEARSE_TTS_PROVIDER=openai; its settings below apply only then.
REHEARSE_TTS_PROVIDER=cartesia
REHEARSE_CARTESIA_TTS_MODEL=sonic-3.6
REHEARSE_CARTESIA_TTS_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
REHEARSE_OPENAI_TTS_MODEL=gpt-4o-mini-tts
REHEARSE_OPENAI_TTS_VOICE=shimmer
REHEARSE_OPENAI_TTS_SPEED=1.0

# Turn settings; tune from real sessions, not from assumed latency.
REHEARSE_VAD_CONFIDENCE=0.7
REHEARSE_VAD_START_SECS=0.2
REHEARSE_VAD_STOP_SECS=0.35
REHEARSE_TURN_PAUSE_SECS=1.1
